# Нормализация переводов строк: в репозитории LF, на Windows checkout без ложных warning.
* text=auto eol=lf

# Windows-скрипты оставляем с CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарники
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.apk binary
*.docx binary
*.zip binary
*.gz binary
*.7z binary

DOMAIN=wms.example.ru
# Same value as DOMAIN: used by API to parse fc-spb.<DOMAIN> into fulfillment.subdomain.
PLATFORM_BASE_DOMAIN=wms.example.ru
# Comma-separated extra apex hosts (optional).
PLATFORM_HOST_ALIASES=
# off | soft | strict. Recommended for production multi-FC: strict.
TENANT_HOST_MODE=strict
POSTGRES_DB=fulfillcore
POSTGRES_USER=fulfillcore
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
APP_SECRET_KEY=CHANGE_ME_AND_NEVER_CHANGE_AFTER_API_KEYS_ARE_SAVED
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$REPLACE$REPLACE
SESSION_TTL_HOURS=12
PRINT_AGENT_TOKEN=CHANGE_ME_RANDOM_PRINT_AGENT_TOKEN
